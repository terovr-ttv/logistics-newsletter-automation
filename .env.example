# Copy this file to .env and fill in your keys.
# Anthropic key: https://console.anthropic.com/
# Mailchimp key: Mailchimp dashboard -> Account -> Extras -> API keys
# Mailchimp list ID: Audience -> Settings -> Audience name and defaults -> Audience ID

ANTHROPIC_API_KEY=sk-ant-your-key-here

MAILCHIMP_API_KEY=your-key-us6
MAILCHIMP_LIST_ID=your-audience-id
